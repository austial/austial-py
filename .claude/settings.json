{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Edit(./public/md/**)",
      "Edit(./public/llms.txt)",
      "Edit(./public/llms-full.txt)",
      "Edit(./public/AGENTS.md)",
      "Edit(./public/setup-agents.sh)",
      "Edit(./public/_pagefind/**)",
      "Edit(./package-lock.json)"
    ]
  }
}
