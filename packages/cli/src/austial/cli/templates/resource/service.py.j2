from src.modules.{{ snake_name }}.entities.{{ snake_name }}_entity import {{ class_name }}


@Injectable()
class {{ class_name }}Service:
    def __init__(self, repository: Repository[{{ class_name }}] = InjectRepository({{ class_name }})):
        self.repository = repository

    async def create(self, dto: Create{{ class_name }}Dto) -> {{ class_name }}:
        return await self.repository.save({{ class_name }}(**dto.model_dump()))

